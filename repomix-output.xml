      await portfolioModule.updateProjectMetrics({
        id: metric.id,
        label_en: metric.label_en,
        label_ar: metric.label_ar,
        value_en: metric.value_en,
        value_ar: metric.value_ar,
        display_order: metric.display_order,
      })
    }
  }
)
