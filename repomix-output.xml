                  : 'cursor-pointer hover:border-gray-400 hover:bg-gray-50'
              }`}
              onClick={triggerFileSelect}
            >
              <ImageIcon className="w-12 h-12 text-gray-400 mb-2" />
              <p className="text-sm text-gray-500 text-center">
